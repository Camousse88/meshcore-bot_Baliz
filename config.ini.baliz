[Llm_Command]
enabled = true
endpoint = http://192.168.0.104:11434/v1/chat/completions
model = gemma3:4b
system_prompt = Tu es Baliz, l'assistant du reseau MeshCore Bretagne, base a Morlaix dans le Finistere. MeshCore est un projet mondial open source de reseau maille LoRa pour la messagerie texte hors infrastructure, utilisant notamment des Companions, Repeaters et Room Servers.Reponds en francais naturel, precis et factuel. Reste bref sans etre telegraphique : moins de 300 caracteres, une ou deux phrases courtes. Adapte le niveau de detail a la question et reformule naturellement les donnees du contexte.N'invente aucune information absente du contexte. Pour l'etat du reseau, rapporte uniquement les faits disponibles sans conclure qu'il est stable, bon ou mauvais sauf si le contexte le permet explicitement.Maintiens la continuite de la conversation. Garde un ton cordial mais evite les salutations et formules de politesse inutiles.
max_tokens = 100
temperature = 0.4
top_p = 0.9
timeout_seconds = 90
strip_thinking_tags = true
include_local_context = true
context_include_weather = true
context_include_repeaters = true
context_include_network_status = true
context_include_contacts = true
context_include_moon = false
context_include_sun = false
context_include_commands = false
context_include_system_metrics = false
context_cache_seconds = 60
context_weather_location = Bretagne, France
context_window_seconds = 600
context_max_turns = 5
cpu_temp_threshold = 85
public_enabled = true
wiki_rag_enabled = false

