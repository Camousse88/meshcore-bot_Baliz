# Profil Baliz issu du LXC 103 — 2026-09-13
# Copier vers le config.ini actif ; voir docs/baliz-config.md.
# Configuration propre à l'installation : radio, chemins et endpoint Ollama à vérifier.
# Sans contournement de scope fr / fr-bre. Aucun secret fourni.

[Connection]
connection_type = serial
serial_port = /dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
ble_device_name = 
hostname = 
tcp_port = 5000
timeout = 30
reconnect_max_retries = 0
reconnect_delay_seconds = 10
reconnect_max_delay_seconds = 60
radio_debug = false
radio_probe_interval_seconds = 300
radio_probe_fail_threshold = 3
radio_zombie_alert_enabled = false
radio_zombie_alert_email = 
